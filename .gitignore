# raw data is downloaded by `make data` (11 CSVs, ~125 MB) and never committed
data/raw/
data/warehouse/
# BI exports are regenerated by `make bi` (CSV ~160 MB, .hyper ~55 MB); parquet marts ARE committed
bi/data/
bi/tableau/*.hyper
# large per-customer / per-order score tables (regenerated by `make analyze`)
reports/tables/rfm_customers.csv
reports/tables/clv_customers.csv
reports/tables/risk_scores.csv
reports/tables/propensity_scores.csv
# dbt
dbt/target/
dbt/dbt_packages/
dbt/logs/
logs/
